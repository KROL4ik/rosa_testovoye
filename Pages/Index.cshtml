@page
@model IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="login-landing text-center py-5">
    <h1 class="mb-3">Сервис бухгалтерских справок</h1>
    <p class="lead text-muted mb-5">
        Выберите тип входа
    </p>

    <div class="d-grid gap-3 col-md-5 col-lg-4 mx-auto">
        <button type="button" class="btn btn-primary btn-lg py-3">
            Вход для сотрудника
        </button>
        <button type="button" class="btn btn-outline-primary btn-lg py-3">
            Вход для бухгалтера
        </button>
    </div>
</div>
