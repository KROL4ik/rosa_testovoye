@page
@model rosa_testovoye.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="py-4">
    <div class="text-center mb-4">
        <h1 class="mb-2">Главная</h1>
        <p class="fs-5 mb-0">@Model.RoleTitle</p>
        <p class="text-muted">@Model.UserFullName</p>
    </div>

    <div id="pageAlert" class="col-lg-8 mx-auto d-none" role="alert"></div>

    @if (Model.IsEmployee)
    {
        <div class="text-center">
            <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#createRequestModal">
                Создать заявку
            </button>
        </div>

        <partial name="_CreateRequestModal" model="Model" />
        <partial name="_MyRequestsList" model="Model" />
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.IsEmployee)
    {
        <partial name="_EmployeeHomeScripts" model="Model" />
    }
}
