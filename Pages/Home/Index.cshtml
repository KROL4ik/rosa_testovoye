@page
@model rosa_testovoye.Pages.Home.IndexModel
@{
    ViewData["Title"] = "Главная";
}

<div class="py-4">
    <div class="text-center mb-4">
        <h1 class="mb-2">Главная</h1>
        <p class="fs-5 mb-0">@Model.RoleTitle</p>
        <p class="text-muted">@Model.UserFullName</p>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success col-lg-8 mx-auto">@Model.SuccessMessage</div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger col-lg-8 mx-auto">@Model.ErrorMessage</div>
    }

    @if (Model.IsEmployee)
    {
        <div class="card col-lg-8 mx-auto shadow-sm">
            <div class="card-body">
                <h2 class="h5 card-title mb-4">Новая заявка на справку</h2>

                @if (Model.ShowDuplicateWarning)
                {
                    <div class="alert alert-warning">
                        У вас уже есть активная заявка этого типа справки. Вы всё равно можете отправить новую.
                    </div>
                }

                <form method="post">
                    <input type="hidden" asp-for="Role" />
                    @if (Model.ShowDuplicateWarning)
                    {
                        <input type="hidden" asp-for="ConfirmDuplicate" value="true" />
                    }

                    <div class="mb-3">
                        <label asp-for="Form.Type" class="form-label"></label>
                        <select asp-for="Form.Type" asp-items="Model.CertificateTypeOptions" class="form-select" id="certificateType"></select>
                        <span asp-validation-for="Form.Type" class="text-danger"></span>
                    </div>

                    <div class="mb-3" id="customTypeBlock" style="display: none;">
                        <label asp-for="Form.CustomTypeName" class="form-label"></label>
                        <input asp-for="Form.CustomTypeName" class="form-control" />
                        <span asp-validation-for="Form.CustomTypeName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.CopiesCount" class="form-label"></label>
                        <input asp-for="Form.CopiesCount" class="form-control" type="number" min="1" max="100" />
                        <span asp-validation-for="Form.CopiesCount" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Form.Reason" class="form-label"></label>
                        <textarea asp-for="Form.Reason" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Form.Reason" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        @(Model.ShowDuplicateWarning ? "Всё равно отправить" : "Отправить заявку")
                    </button>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const typeSelect = document.getElementById('certificateType');
            const customBlock = document.getElementById('customTypeBlock');
            const customType = @((int)rosa_testovoye.Data.Enums.CertificateType.Custom);

            function toggleCustom() {
                customBlock.style.display = typeSelect.value === String(customType) ? 'block' : 'none';
            }

            typeSelect.addEventListener('change', toggleCustom);
            toggleCustom();
        })();
    </script>
}
